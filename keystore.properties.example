# Copy to keystore.properties (git-ignored) and fill in. Keep the .jks file OUTSIDE this repo and back it up.
# Create the upload key yourself:
#   keytool -genkeypair -v -keystore ~/keys/docscanner-upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
# With Play App Signing, Google holds the app signing key; this is only the upload key.
storeFile=/absolute/path/to/docscanner-upload.jks
storePassword=
keyAlias=upload
keyPassword=
