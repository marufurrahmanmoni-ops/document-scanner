  "font": {
    "sans": "Inter, Noto Sans Bengali, Roboto, sans-serif",
    "bengali": "Noto Sans Bengali",
    "mono": "JetBrains Mono, Roboto Mono, monospace",
    "_note": "Inter (OFL) for Latin, Noto Sans Bengali (OFL) for Bengali UI text and OCR results. Bundle both in res/font so the app works offline. No licensed fonts."
  },

  "type": {
    "display":   {"size": 32, "line": 40, "weight": 700, "tracking": -0.5, "bengali_line": 46},
    "headline":  {"size": 24, "line": 32, "weight": 700, "tracking": -0.25, "bengali_line": 36},
    "title-lg":  {"size": 20, "line": 28, "weight": 600, "tracking": 0, "bengali_line": 32},
    "title":     {"size": 16, "line": 24, "weight": 600, "tracking": 0, "bengali_line": 28},
    "body":      {"size": 16, "line": 24, "weight": 400, "tracking": 0, "bengali_line": 28},
    "body-sm":   {"size": 14, "line": 20, "weight": 400, "tracking": 0, "bengali_line": 24},
    "label":     {"size": 14, "line": 20, "weight": 600, "tracking": 0.1, "bengali_line": 24},
    "label-sm":  {"size": 12, "line": 16, "weight": 600, "tracking": 0.2, "bengali_line": 20},
    "caption":   {"size": 12, "line": 16, "weight": 400, "tracking": 0.2, "bengali_line": 20},
    "overline":  {"size": 11, "line": 16, "weight": 600, "tracking": 0.8, "case": "upper", "bengali_line": 20, "_bengali_note": "no uppercase for Bengali; use label-sm instead"}
