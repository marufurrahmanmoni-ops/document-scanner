    "pressed": "rgba(17,24,39,0.08)",
    "selected": "rgba(31,95,214,0.10)"
  },

  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-sunken"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-sunken"],
    ["text-subtle", "bg"],
    ["text-subtle", "surface"],
    ["on-accent", "accent"],
    ["on-accent", "accent-pressed"],
    ["accent", "bg"],
    ["accent", "surface"],
    ["on-accent-container", "accent-container"],
    ["accent", "accent-container"],
    ["danger", "bg"],
    ["on-danger", "danger"],
    ["danger", "danger-container"],
    ["success", "bg"],
    ["success", "success-container"],
    ["warning", "bg"],
    ["warning", "warning-container"],
    ["camera-text", "camera-bg"],
    ["camera-text", "camera-surface"],
    ["camera-text-muted", "camera-bg"],
    ["camera-text-muted", "camera-surface"],
    ["border-input", "bg", "ui"],
    ["border-input", "surface", "ui"],
    ["focus", "bg", "ui"],
    ["focus", "surface", "ui"],
    ["edge-searching", "camera-bg", "ui"],
    ["edge-detected", "camera-bg", "ui"],
    ["edge-locked", "camera-bg", "ui"],
    ["accent", "camera-bg", "ui"]
