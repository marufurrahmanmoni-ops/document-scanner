{
  "_about": "Design tokens for the document scanner (working name: Scanner). These are roles, not brand: replica-brand may change the values but keeps the names. Units: dp for size, sp for type. Check after every change: python3 contrast.py replica/design/tokens.json",
  "_reference": "CamScanner is a functional UX reference only (flows, states, screen jobs). No colours, icons, copy or layouts were taken from it. Its brand colour is green; this system is blue and neutral.",

  "color": {
    "bg": "#FFFFFF",
    "surface": "#F5F7FA",
    "surface-sunken": "#EBEEF3",
    "border": "#E2E6EC",
    "border-strong": "#C9CFD8",
    "border-input": "#7F8896",

    "text": "#111827",
    "text-muted": "#4B5563",
    "text-subtle": "#666F7C",
    "text-disabled": "#9AA3AF",

    "accent": "#1F5FD6",
    "accent-pressed": "#174BB0",
    "on-accent": "#FFFFFF",
    "accent-container": "#E8F0FE",
    "on-accent-container": "#0E3A8C",

    "danger": "#C42B2B",
    "danger-container": "#FDECEC",
    "on-danger": "#FFFFFF",
    "success": "#1B7A45",
    "success-container": "#E6F4EC",
    "warning": "#9A5800",
    "warning-container": "#FFF4E0",

    "camera-bg": "#0B0D10",
