    "_note": "Compose shadow elevation in dp. Prefer a 1dp border over a shadow on white; shadows are for things that float.",
    "flat": 0,
    "page": 2,
    "raised": 3,
    "fab": 6,
    "sheet": 8,
    "menu": 8
  },

  "size": {
    "touch-min": 48,
    "icon-sm": 20,
    "icon": 24,
    "icon-lg": 32,
    "top-bar": 64,
    "bottom-nav": 80,
    "scan-fab": 64,
    "fab": 56,
    "shutter": 76,
    "shutter-inner": 62,
    "button-sm": 36,
    "button-md": 44,
    "button-lg": 52,
    "input": 52,
    "list-row": 72,
    "list-row-compact": 56,
    "doc-card-min-width": 156,
    "page-thumb": 64,
    "crop-handle": 24,
    "crop-handle-hit": 48,
    "loupe": 112,
    "nav-rail": 80,
    "content-max": 840
