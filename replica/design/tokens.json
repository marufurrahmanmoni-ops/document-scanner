    "camera-text": "#FFFFFF",
    "camera-text-muted": "#B8C0CC",
    "edge-searching": "#FFFFFF",
    "edge-detected": "#5B9BFF",
    "edge-locked": "#3DD68C",

    "page": "#FFFFFF",
    "focus": "#1F5FD6"
  },

  "overlay": {
    "scrim": "rgba(17,24,39,0.48)",
